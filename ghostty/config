# Config de Ghostty — opciones: https://ghostty.org/docs/config
# Recargar: Ctrl+Shift+, (Linux) o Cmd+Shift+, (macOS)

theme = GitHub Dark
font-family = Fira Code
font-size = 11

# Compacto: poco margen y algo menos de interlineado
window-padding-x = 2
window-padding-y = 0
window-padding-balance = true
adjust-cell-height = -5%

# Integración con el shell: saltar entre prompts, sudo conservando terminfo
# y el título de la pestaña con el comando en curso
shell-integration-features = cursor,sudo,title
